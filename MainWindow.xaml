<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NicoleToolbox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NicoleToolbox"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NicoleToolbox">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TitleBar x:Name="MainTitleBar" Title="NicoleToolbox" Grid.Row="0" IsPaneToggleButtonVisible="True" PaneToggleRequested="MainTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/NicoleToolbox.ico" />
            </TitleBar.IconSource>
        </TitleBar>
        <NavigationView x:Name="Nav" SelectionChanged="Nav_SelectionChanged" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" PaneDisplayMode="Left" OpenPaneLength="200" Grid.Row="1" IsPaneToggleButtonVisible="False">
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Home" Content="主页" Tag="Home" x:Name="Nav_HomeItem"/>
                <NavigationViewItem Icon="Repair" Content="系统工具" Tag="Tools"/>
                <NavigationViewItem Content="关于" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="MainFrame"/>
        </NavigationView>
    </Grid>
</Window>
