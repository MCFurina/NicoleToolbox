<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NicoleToolbox.WidgetWindow.GitHubProxyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NicoleToolbox.WidgetWindow"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="GitHub Download Proxy">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollView Grid.Row="0">
            <StackPanel Orientation="Vertical">
                <Border Style="{StaticResource CardBorderStyle}" Margin="10" x:Name="InputCard">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Uid="GitHubProxyWindow_InputBox" Grid.Column="0" x:Name="Input"/>
                        <Button Style="{StaticResource AccentButtonStyle}" x:Uid="GitHubProxyWindow_ConvertButton" Grid.Column="1" Margin="10,0,0,0" x:Name="ConvertButton" Click="ConvertButton_Click"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" x:Name="TeachCard" Visibility="Visible" Margin="10">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Uid="GitHubProxyWindow_TeachCard_Title" Style="{StaticResource BodyLargeStrongTextBlockStyle}" Margin="0,0,0,10"/>
                        <TextBlock x:Uid="GitHubProxyWindow_TeachCard_Content"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" x:Name="OutputCard" Visibility="Collapsed" Margin="10">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Uid="GitHubProxyWindow_OutputCard_Title" HorizontalAlignment="Left" Style="{StaticResource BodyLargeStrongTextBlockStyle}" Margin="0,0,0,10"/>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                            <StackPanel Orientation="Vertical">
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Cloudflare 1"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" IsReadOnly="True" x:Name="Output1"/>
                                    <Button x:Uid="GitHubProxyWindow_CopyButton" Grid.Column="1" Margin="10,0,0,0" x:Name="CopyButton1" Click="CopyButton1_Click"/>
                                    <Button x:Uid="GitHubProxyWindow_OpenButton" Grid.Column="2" Margin="10,0,0,0" x:Name="OpenButton1" Click="OpenButton1_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                            <StackPanel Orientation="Vertical">
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Cloudflare 2"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" IsReadOnly="True" x:Name="Output2"/>
                                    <Button x:Uid="GitHubProxyWindow_CopyButton" Grid.Column="1" Margin="10,0,0,0" x:Name="CopyButton2" Click="CopyButton2_Click"/>
                                    <Button x:Uid="GitHubProxyWindow_OpenButton" Grid.Column="2" Margin="10,0,0,0" x:Name="OpenButton2" Click="OpenButton2_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                            <StackPanel Orientation="Vertical">
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Cloudflare 3"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" IsReadOnly="True" x:Name="Output3"/>
                                    <Button x:Uid="GitHubProxyWindow_CopyButton" Grid.Column="1" Margin="10,0,0,0" x:Name="CopyButton3" Click="CopyButton3_Click"/>
                                    <Button x:Uid="GitHubProxyWindow_OpenButton" Grid.Column="2" Margin="10,0,0,0" x:Name="OpenButton3" Click="OpenButton3_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                            <StackPanel Orientation="Vertical">
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Fastly"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" IsReadOnly="True" x:Name="Output4"/>
                                    <Button x:Uid="GitHubProxyWindow_CopyButton" Grid.Column="1" Margin="10,0,0,0" x:Name="CopyButton4" Click="CopyButton4_Click"/>
                                    <Button x:Uid="GitHubProxyWindow_OpenButton" Grid.Column="2" Margin="10,0,0,0" x:Name="OpenButton4" Click="OpenButton4_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                            <StackPanel Orientation="Vertical">
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="AxisNow"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" IsReadOnly="True" x:Name="Output5"/>
                                    <Button x:Uid="GitHubProxyWindow_CopyButton" Grid.Column="1" Margin="10,0,0,0" x:Name="CopyButton5" Click="CopyButton5_Click"/>
                                    <Button x:Uid="GitHubProxyWindow_OpenButton" Grid.Column="2" Margin="10,0,0,0" x:Name="OpenButton5" Click="OpenButton5_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollView>
        <HyperlinkButton x:Uid="GitHubProxyWindow_BottomLinkButton" VerticalAlignment="Bottom" HorizontalAlignment="Center" NavigateUri="https://gh-proxy.com/" Grid.Row="1"/>
    </Grid>
</Window>
